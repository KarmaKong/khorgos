#!/usr/bin/env bash
set -euo pipefail

echo "==> npm ci"
time npm ci

echo "==> build site"
time npm run build

if git remote get-url github >/dev/null 2>&1; then
  git remote set-url github https://github.com/KarmaKong/khorgos.git
else
  git remote add github https://github.com/KarmaKong/khorgos.git
fi

echo "==> setup done"
